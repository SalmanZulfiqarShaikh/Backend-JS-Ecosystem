<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | API Key Manager</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }
        body { 
            background: #141c3a; /* Deep Navy Base */
            color: #e2e8f0; min-height: 100vh; 
            background-image: radial-gradient(circle at top right, #1d2a57, #141c3a); 
        }
        .navbar {
            background: rgba(255, 255, 255, 0.01); backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04); padding: 1.2rem 5%;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 50;
        }
        .navbar h2 { background: linear-gradient(to right, #3dc7b7, #ffffff); -webkit-background-clip: text; color: transparent; font-weight: 600; }
        .nav-links a { color: #a1b0cb; text-decoration: none; margin-left: 1.5rem; transition: color 0.3s; font-weight: 400; }
        .nav-links a:hover { color: #f8fafc; }
        
        .container { max-width: 1200px; margin: 3rem auto; padding: 0 5%; animation: fadeIn 0.6s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .header-section { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
        .header-section h1 { font-size: 2.5rem; color: #f8fafc; }
        .header-section p { color: #a1b0cb; margin-top: 0.5rem; }
        
        .btn {
            padding: 0.8rem 1.5rem; border: none; border-radius: 10px;
            /* Navy to Teal gradient for buttons */
            background: linear-gradient(135deg, #1d2a57, #3dc7b7); color: white;
            cursor: pointer; font-weight: 600; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
        }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(61, 199, 183, 0.6); }
        
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
        .api-card {
            background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px; padding: 1.8rem; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative; overflow: hidden;
        }
        .api-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px;
            /* Aqua Green top line on cards */
            background: linear-gradient(to right, #84edd1, #3dc7b7); opacity: 0; transition: opacity 0.3s;
        }
        .api-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -15px rgba(0,0,0,0.6); border-color: rgba(61, 199, 183, 0.3); }
        .api-card:hover::before { opacity: 1; }
        
        .api-name { font-size: 1.3rem; font-weight: 600; margin-bottom: 1.2rem; color: #f8fafc; display: flex; align-items: center; gap: 0.5rem; }
        /* Green status dot enhanced */
        .status-dot { width: 8px; height: 8px; background: #84edd1; border-radius: 50%; box-shadow: 0 0 10px #84edd1; }
        
        .api-key-box {
            background: rgba(10, 15, 30, 0.6); padding: 1rem; border-radius: 10px;
            display: flex; justify-content: space-between; align-items: center;
            border: 1px solid rgba(255,255,255,0.04); gap: 1rem;
        }
        /* API keys now use e.ocean Aqua Green */
        .api-key-box code { font-family: monospace; color: #84edd1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.95rem; }
        
        .copy-btn {
            background: transparent; border: 1px solid #3dc7b7; color: #3dc7b7;
            padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.2s; white-space: nowrap;
        }
        .copy-btn:hover { background: rgba(61, 199, 183, 0.1); }
        /* Copied state uses the same Aqua Green */
        .copy-btn.copied { background: #3dc7b7; border-color: #3dc7b7; color: #141c3a; }

        .empty-state { text-align: center; padding: 4rem 2rem; background: rgba(255,255,255,0.01); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.08); grid-column: 1 / -1; }
        .empty-state h3 { font-size: 1.5rem; color: #f8fafc; margin-bottom: 0.5rem; }
        .empty-state p { color: #a1b0cb; margin-bottom: 1.5rem; }

        .new-api-form {
            background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem; display: flex; gap: 1rem; align-items: center;
            flex-wrap: wrap;
        }
        .new-api-form input {
            flex: 1; min-width: 200px; padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08);
            background: rgba(10, 15, 30, 0.5); color: white; outline: none; transition: border-color 0.3s;
        }
        .new-api-form input:focus { border-color: #3dc7b7; }
    </style>
</head>
<body>
    <nav class="navbar">
        <h2>API Key Manager</h2>
        <div class="nav-links">
            <a href="/">Create New Account</a>
            <a href="/login">Switch Account</a> 
        </div>
    </nav>

    <div class="container">
        <div class="header-section">
            <div>
                <h1>Dashboard</h1>
                <p>Manage and monitor your project API keys</p>
            </div>
        </div>

        <form class="new-api-form" action="/api" method="POST">
            <input type="text" name="name" required placeholder="New API Name (e.g. Production Env)">
            <input type="text" name="value" required placeholder="API Key Value (e.g. pk_test_...)">
            <button class="btn" type="submit">Create Key</button>
        </form>

        <div class="card-grid">
            <% if (locals.apis && apis.length > 0) { %>
                <% apis.forEach(api => { %>
                    <div class="api-card">
                        <div class="api-name">
                            <span class="status-dot"></span>
                            <%= api.name %>
                        </div>
                        <div class="api-key-box">
                            <code id="key-<%= api._id %>"><%= api.value %></code>
                            <button class="copy-btn" onclick="copyToClipboard('key-<%= api._id %>', this)">Copy</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <h3>No API Keys Found</h3>
                    <p>You haven't generated any API keys yet. Create one above to get started.</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function copyToClipboard(elementId, btn) {
            const copyText = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(copyText).then(() => {
                const originalText = btn.innerText;
                btn.innerText = 'Copied!';
                btn.classList.add('copied');
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.classList.remove('copied');
                }, 2000);
            });
        }
    </script>
</body>
</html>