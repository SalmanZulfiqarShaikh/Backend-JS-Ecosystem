<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | API Manager</title>
    <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQA-mTL9pCoVxyaiV1j_w-9owCC2ErBP3sNXA&s" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Specific overrides for the delete layout */
        .control-btns {
            display: flex;
            gap: 8px;
        }
        .btn-delete:hover {
            background: #000 !important;
            color: #fff !important;
            border-color: #000 !important;
            opacity: 0.8;
        }
        /* Simple fade out animation */
        .removing {
            opacity: 0;
            transform: scale(0.95);
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-logo-container">
            <a href="https://eocean.net/" target="_blank"><img src="https://eocean.net/wp-content/uploads/2025/09/eocean-logo.png" alt="e.ocean Logo" class="mini-logo"></a>
        </div>
        <div class="nav-links">
            <a href="/user/logout">Logout</a>
        </div>
    </nav>

    <div class="container">
        <header style="margin-bottom: 3rem;">
            <h1>Project Keys</h1>
            <p class="subtitle" style="text-align: left;">Manage your secure access credentials for e.ocean integrations.</p>
        </header>

        <form style="display: flex; gap: 10px; margin-bottom: 2rem;" action="/api" method="POST">
            <input type="text" name="name" placeholder="API Name (e.g. Production)" required>
            <input type="text" name="value" placeholder="Key Value" required>
            <button class="btn-primary" style="width: auto; white-space: nowrap;" type="submit">Add Key</button>
        </form>

        <div class="card-list">
            <% if (locals.apis && apis.length > 0) { %>
                <% apis.forEach(api => { %>
                    <div class="api-card" id="card-<%= api._id %>">
                        <div class="api-info">
                            <h3><%= api.name %></h3>
                            <code class="api-key-display"><%= api.value %></code>
                        </div>
                        <div class="control-btns">
                            <button class="btn-outline" onclick="copyToClipboard('<%= api.value %>', this)">Copy</button>
                            <button class="btn-outline btn-delete" onclick="confirmDelete('<%= api._id %>')">Delete</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 4rem; border: 1px dashed #ddd; border-radius: 12px;">
                    <p style="color: #999; font-weight: 300;">No API keys found. Add one above to get started.</p>
                </div>
            <% } %>
        </div>
    </div>
    
    <script>
        // 1. Copy to Clipboard Logic
        function copyToClipboard(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const oldText = btn.innerText;
                btn.innerText = 'Copied!';
                btn.style.background = "#eee";
                setTimeout(() => {
                    btn.innerText = oldText;
                    btn.style.background = "transparent";
                }, 2000);
            });
        }

        // 2. Delete Logic (Handles your router.delete and res.redirect)
        async function confirmDelete(apiId) {
            if (!confirm("Are you sure you want to delete this API key? This action cannot be undone.")) {
                return;
            }

            try {
                const response = await fetch(`/api/${apiId}`, {
                    method: 'DELETE',
                });

                if (response.redirected) {
                    // This will trigger your backend's res.redirect("/home")
                    window.location.href = response.url;
                } else if (response.ok) {
                    // Fallback: Manually remove if no redirect occurs
                    const card = document.getElementById(`card-${apiId}`);
                    card.classList.add('removing');
                    setTimeout(() => card.remove(), 300);
                } else {
                    alert("Failed to delete key. Please try again.");
                }
            } catch (err) {
                console.error("Delete Error:", err);
                alert("An error occurred. Check console.");
            }
        }
    </script>
</body>
</html>