=<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | API Manager</title>
    <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQA-mTL9pCoVxyaiV1j_w-9owCC2ErBP3sNXA&s" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .control-btns { display: flex; gap: 8px; }
        .btn-delete:hover { background: #ff4d4d !important; color: #fff !important; border-color: #ff4d4d !important; }
        .removing { opacity: 0; transform: scale(0.95); transition: 0.3s; }
    </style>
</head>
<body class="dashboard-body">
    <nav class="navbar">
        <div class="nav-logo-container">
            <a href="https://eocean.net/" target="_blank">
                <img src="https://eocean.net/wp-content/uploads/2025/09/eocean-logo.png" alt="Logo" class="mini-logo">
            </a>
        </div>
        <div class="nav-links">
            <a href="/user/logout" style="color: #666; text-decoration: none;">Logout</a>
        </div>
    </nav>

    <div class="container">
        <header style="margin-bottom: 3rem;">
            <h1>Project Keys</h1>
            <p class="subtitle" style="text-align: left;">Manage your credentials for e.ocean integrations.</p>
        </header>

        <form style="display: flex; gap: 10px; margin-bottom: 2rem;" action="/api" method="POST">
            <input type="text" name="name" placeholder="API Name" required>
            <input type="text" name="value" placeholder="Key Value" required>
            <button class="btn-primary" style="width: auto; white-space: nowrap;" type="submit">Add Key</button>
        </form>

        <div class="card-list">
            <% if (locals.apis && apis.length > 0) { %>
                <% apis.forEach(api => { %>
                    <div class="api-card" id="card-<%= api._id %>">
                        <div class="api-info">
                            <h3 style="font-size: 1rem; margin-bottom: 5px;"><%= api.name %></h3>
                            <code class="api-key-display"><%= api.value %></code>
                        </div>
                        <div class="control-btns">
                            <button class="btn-outline" onclick="copyToClipboard('<%= api.value %>', this)">Copy</button>
                            <button class="btn-outline btn-delete" onclick="confirmDelete('<%= api._id %>')">Delete</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 4rem; border: 1px dashed #ddd; border-radius: 12px;">
                    <p style="color: #999;">No keys found. Add one above.</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function copyToClipboard(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const oldText = btn.innerText;
                btn.innerText = 'Copied!';
                setTimeout(() => btn.innerText = oldText, 2000);
            });
        }

        async function confirmDelete(apiId) {
            if (!confirm("Delete this key?")) return;
            const response = await fetch(`/api/${apiId}`, { method: 'DELETE' });
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                document.getElementById(`card-${apiId}`).classList.add('removing');
                setTimeout(() => location.reload(), 300);
            }
        }
    </script>
</body>
</html>