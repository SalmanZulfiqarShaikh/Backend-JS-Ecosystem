<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | API Key Manager</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
        }
        body {
            /* Changed background to e.ocean Navy gradient */
            background: linear-gradient(135deg, #1d2a57, #141c3a);
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.02); /* More subtle glass */
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 3rem;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.6); /* Deeper shadow */
            animation: fadeIn 0.6s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        h1 {
            font-size: 2.2rem; margin-bottom: 0.5rem; text-align: center;
            /* Gradient now shifts from e.ocean Teal to White */
            background: linear-gradient(to right, #3dc7b7, #ffffff);
            -webkit-background-clip: text; color: transparent; font-weight: 600;
        }
        p.subtitle { text-align: center; color: #a1b0cb; margin-bottom: 2rem; font-weight: 300; }
        .form-group { margin-bottom: 1.2rem; position: relative; }
        .form-group input {
            width: 100%; padding: 1rem 1.2rem;
            /* Inputs use deep navy background */
            background: rgba(10, 15, 30, 0.5); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px; color: #fff; font-size: 1rem; outline: none; transition: all 0.3s;
        }
        .form-group input:focus {
            /* Focus highlight is now e.ocean Teal */
            border-color: #3dc7b7;
            box-shadow: 0 0 0 2px rgba(61, 199, 183, 0.2);
            background: rgba(10, 15, 30, 0.7);
        }
        .form-group input::placeholder { color: #6e7a9c; }
        input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 30px #141c3a inset !important;
            -webkit-text-fill-color: #fff !important;
        }
        button {
            width: 100%; padding: 1rem; border: none; border-radius: 12px; margin-top: 1rem;
            /* Buttons use e.ocean Teal base */
            background: linear-gradient(135deg, #3dc7b7, #1d2a57);
            color: white; font-size: 1.1rem; font-weight: 600;
            cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
        }
        button:hover {
            transform: translateY(-2px);
            /* Teal shadow glow */
            box-shadow: 0 10px 20px -10px rgba(61, 199, 183, 0.6);
        }
        .footer-text { margin-top: 1.5rem; text-align: center; color: #a1b0cb; }
        /* Links use e.ocean Aqua Green */
        .footer-text a { color: #84edd1; text-decoration: none; font-weight: 600; transition: color 0.3s; }
        .footer-text a:hover { color: #3dc7b7; }
        /* Error message adjusted for contrast */
        .error-msg { background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-left: 4px solid #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="glass-panel">
    <h1>Create Account</h1>
    <p class="subtitle">Join to manage your secure API keys.</p>

    <% if (locals.error) { %>
        <div class="error-msg" id="error-banner"><%= error %></div>
    <% } %>

    <form action="/user" method="POST">
        <div class="form-group">
            <input type="text" name="name" required placeholder="Full Name" minlength="3" maxlength="20">
        </div>
        <div class="form-group">
            <input type="text" name="username" required placeholder="Username" 
                   pattern="^[a-zA-Z0-9_]+$" title="Only letters, numbers, and underscores allowed"
                   minlength="3" maxlength="16">
        </div>
        <div class="form-group">
            <input type="email" name="email" required placeholder="Email Address">
        </div>
        <div class="form-group">
            <input type="password" name="password" required placeholder="Password (8-16 chars)" 
                   minlength="8" maxlength="16">
        </div>
        <button type="submit">Sign Up</button>
    </form>

    <div class="footer-text">
        Already have an account? <a href="/login">Login here</a>
    </div>
</div>
</body>
</html>