<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | API Manager</title>
    <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQA-mTL9pCoVxyaiV1j_w-9owCC2ErBP3sNXA&s" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body style="display: flex; align-items: center; justify-content: center;">
    <div class="auth-card">
        <img src="https://eocean.net/wp-content/uploads/2025/09/eocean-logo.png" alt="e.ocean" class="brand-logo">
        <h1>Welcome back</h1>
        <p class="subtitle">Please enter your details</p>

        <% if (locals.error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/user/login" method="POST">
            <div class="form-group">
                <input type="text" name="identifier" required placeholder="Email or Username">
            </div>
            <div class="form-group">
                <input type="password" name="password" required placeholder="Password">
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="footer-text">
            New here? <a href="/">Create an account</a>
        </div>
    </div>
</body>
</html>