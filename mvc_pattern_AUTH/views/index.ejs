<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener | eOcean</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .bg-ocean { background-color: #3D418A; }
        .text-teal { color: #70C9C2; }
        .border-teal { border-color: #70C9C2; }
    </style>
</head>
<body class="min-h-screen">

    <nav class="bg-ocean text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <img src="https://help.eocean.net/knowledge/wp-content/uploads/2025/09/Eocean-Logo-01-new.webp" 
                 alt="eOcean Logo" class="h-8 brightness-0 invert">
            <div class="flex items-center space-x-4">
                <span class="text-sm opacity-80">Full Stack AI Tool</span>
                <div class="h-8 w-8 rounded-full bg-teal-400 flex items-center justify-center font-bold text-ocean">S</div>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-10">
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 mb-10">
            <h1 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
                <svg class="w-6 h-6 mr-2 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                Generate Short URL
            </h1>
            
            <form action="/url" method="POST" class="flex flex-col md:flex-row gap-4">
                <div class="flex-grow">
                    <input type="text" name="url" placeholder="https://example.com/very-long-link-to-shorten" 
                        class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:ring-2 focus:ring-[#70C9C2] focus:border-transparent outline-none transition-all">
                </div>
                <button type="submit" class="bg-ocean hover:bg-[#2D3066] text-white font-bold px-8 py-4 rounded-xl transition-all shadow-md active:scale-95">
                    Shorten Link
                </button>
            </form>

            <% if(locals.id) { %>
                <div class="mt-6 p-4 bg-teal-50 border border-teal-200 rounded-xl flex items-center justify-between">
                    <div>
                        <span class="text-sm text-teal-800 font-medium">Success! Your link is ready:</span>
                        <p class="text-lg font-bold text-ocean">http://localhost:3000/<%= locals.id %></p>
                    </div>
                    <button onclick="navigator.clipboard.writeText('http://localhost:3000/<%= locals.id %>')" class="text-ocean hover:underline text-sm font-bold">Copy Link</button>
                </div>
            <% } %>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="px-8 py-6 border-b border-slate-100 flex justify-between items-center">
                <h2 class="text-xl font-bold text-slate-800">Your Analytics</h2>
                <span class="bg-slate-100 text-slate-600 text-xs font-bold px-3 py-1 rounded-full uppercase">
                    <%= (locals.urls) ? locals.urls.length : 0 %> Active Links
                </span>
            </div>

            <div class="overflow-x-auto">
                <% if (locals.urls && locals.urls.length > 0) { %>
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-slate-50 text-slate-400 text-xs uppercase tracking-widest">
                                <th class="px-8 py-4 font-bold">S. No</th>
                                <th class="px-8 py-4 font-bold">Short Link</th>
                                <th class="px-8 py-4 font-bold">Original URL</th>
                                <th class="px-8 py-4 font-bold text-center">Total Clicks</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% locals.urls.forEach(function(url, index) { %>
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-8 py-5 text-slate-500 font-medium"><%= index + 1 %></td>
                                    <td class="px-8 py-5">
                                        <a href="http://localhost:3000/<%= url.shortId %>" target="_blank" class="text-ocean font-bold hover:text-teal transition-colors">
                                            /<%= url.shortId %>
                                        </a>
                                    </td>
                                    <td class="px-8 py-5 text-slate-600 truncate max-w-xs text-sm"><%= url.redirectURL %></td>
                                    <td class="px-8 py-5 text-center">
                                        <span class="bg-teal-100 text-teal-800 px-3 py-1 rounded-lg text-sm font-bold">
                                            <%= url.visitedHistory.length %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="p-20 text-center">
                        <div class="text-slate-300 mb-4">
                            <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                        </div>
                        <p class="text-slate-500 font-medium">No links created yet. Start by shortening your first URL!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

</body>
</html>